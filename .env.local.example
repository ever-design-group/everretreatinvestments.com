# Cloudflare Turnstile — get these from dash.cloudflare.com > Turnstile > Add widget.
# Copy this file to .env.local and fill in your real values.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is safe to expose in the browser.
# TURNSTILE_SECRET_KEY must stay server-side only — never commit it, never
# prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (resend.com) — sends enquiry-form submissions directly to an inbox,
# in addition to the existing WhatsApp deep-link flow. Get RESEND_API_KEY
# from resend.com/api-keys. ENQUIRY_FROM_EMAIL must be on a domain you've
# verified in Resend (their dashboard walks through the DNS records) —
# Resend rejects sends from an unverified domain. ENQUIRY_TO_EMAIL is the
# real inbox that should receive every enquiry; without it the API route
# refuses to send rather than silently emailing nowhere.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=enquiries@everretreatinvestments.com
ENQUIRY_TO_EMAIL=info@everretreatinvestments.com
