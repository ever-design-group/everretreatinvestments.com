# Cloudflare Turnstile — get these from dash.cloudflare.com > Turnstile > Add widget.
# Copy this file to .env.local and fill in your real values.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is safe to expose in the browser.
# TURNSTILE_SECRET_KEY must stay server-side only — never commit it, never
# prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SMTP — sends enquiry-form submissions directly to an inbox, in addition
# to the existing WhatsApp deep-link flow. Uses Ever Retreat's own existing
# mailbox (admin@) rather than a separate email service, so no domain DNS
# changes are needed. Host/port/user below are confirmed from the hosting
# control panel's "Connect Devices" page for admin@everretreatinvestments.com.
# SMTP_PASSWORD is that mailbox's own password — never commit a real value
# here; set it in your local .env.local and in Vercel's environment
# variables instead. ENQUIRY_TO_EMAIL is the real inbox that should receive
# every enquiry; without all of these the API route refuses to send rather
# than silently emailing nowhere.
SMTP_HOST=everretreatinvestments.com
SMTP_PORT=465
SMTP_USER=admin@everretreatinvestments.com
SMTP_PASSWORD=
ENQUIRY_FROM_EMAIL=admin@everretreatinvestments.com
ENQUIRY_TO_EMAIL=info@everretreatinvestments.com
